<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>               <string>dbui</string>
  <key>CFBundleDisplayName</key>        <string>dbui</string>
  <key>CFBundleIdentifier</key>         <string>com.gzenit.dbui</string>
  <key>CFBundleExecutable</key>         <string>dbui</string>
  <key>CFBundleIconFile</key>           <string>dbui</string>
  <key>CFBundlePackageType</key>        <string>APPL</string>
  <key>CFBundleVersion</key>            <string>__VERSION__</string>
  <key>CFBundleShortVersionString</key> <string>__VERSION__</string>
  <!-- gpui targets Metal, which needs Big Sur. -->
  <key>LSMinimumSystemVersion</key>     <string>11.0</string>
  <key>NSHighResolutionCapable</key>    <true/>
  <key>NSHumanReadableCopyright</key>   <string>dbui — a database editor for PostgreSQL and MySQL</string>
  <!-- dbui draws its own titlebar; without this the system one flashes on
       launch before the window takes over. -->
  <key>NSRequiresAquaSystemAppearance</key> <false/>
</dict>
</plist>
